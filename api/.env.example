PORT=8080
# MongoDB — local, or Atlas (e.g. mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/)
MONGODB_URL=mongodb://root:example@localhost:27017/
MONGODB_DB_NAME=relativity

# Voyager data API. Hosted by default; local dev can point at a local instance.
VOYAGER_URL=https://voyager-1hpq.onrender.com
# Optional server-side fallback key. Users normally provide their own Voyager
# API key in Settings (sent as X-Voyager-Key); this is used when none is set.
# VOYAGER_API_KEY=vgr_xxxxx
# Requests per minute the Voyager key allows (used to throttle client calls).
# VOYAGER_RPM=60

OLLAMA_URL=http://localhost:11434/v1

# Optional server-side LLM key fallbacks. Keys are normally sent by the
# browser as X-LLM-{Provider}-Key headers (see the Settings page).
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
