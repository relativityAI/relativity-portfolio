  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Investor composes → React SPA → Express API → Run Service",
        "Run Service enqueues an Inngest event; durable functions retry",
        "Skill analysts run per-skill, verdicts persist to Supabase",
        "Delivery: result page, SSE trace, and PDF export all read the stored run",
        "Honest scoring: headline suppressed below 60% coverage"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data grounding",
      "items": [
        "Step-0 toolChoice forces every analyst to call tools first",
        "Voyager (internal) supplies filings and metrics; keyless runs fall back to DuckDuckGo search",
        "Tavily upgrades search when a key is set; Yahoo Finance prices the charts"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "UI authenticates with Supabase; every API route verifies the JWT",
        "Analysts scope every query by user_id — no cross-tenant reads",
        "Tool results are wrapped as untrusted content; scores are never invented"
      ]
    }
  ]
