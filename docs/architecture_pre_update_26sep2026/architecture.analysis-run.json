      "dot": "rose",
      "title": "Server trust zone",
      "items": [
        "LLM, Voyager, and Tavily keys are decrypted in-process and never returned unmasked",
        "assertSafePdfUrl blocks private ranges; tool output is wrapped as [UNTRUSTED …]"
      ]
    },
