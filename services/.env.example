PORT=8080

# Supabase — auth only (JWT verification via JWKS). Data lives in Postgres.
SUPABASE_PROJECT_URL=https://rjqhhxdsbghjljiuohzh.supabase.co

# Local Postgres (docker compose: `docker compose up -d postgres`) — API keys + user activity.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relativity

# AES-256-GCM encryption key for stored API keys (64 hex chars = 32 bytes).
ENCRYPTION_KEY=

# Voyager data API.
VOYAGER_URL=https://voyager-api-0csb.onrender.com
# Admin key used to call Voyager's POST /admin/keys endpoint (auto-provision on signup).
VOYAGER_ADMIN_KEY=
# data:read key for Voyager data routes (X-API-Key). Needed by standalone scripts
# (the HTTP pipeline uses each user's provisioned key instead).
VOYAGER_API_KEY=
# Requests per minute the Voyager key allows (used to throttle client calls).
VOYAGER_RPM=60

# MCP server urls. The harness reads which servers to use from
# harness.config.json (`tools.mcp[]`) — each entry names the env var holding
# its url via urlEnv (voyager's default: MCP_VOYAGER_URL below). Streamable
# HTTP, e.g. http://localhost:8002/mcp. Tools are re-listed from each server
# on every run, so new tools appear without restarting this API.
# MCP_VOYAGER_URL=

# Per-run budgets for skill/iterative runs ("calls" = model steps / tool round-trips).
AGENT_MAX_STEPS=40
AGENT_MAX_TOKENS=200000

OLLAMA_URL=http://localhost:11434/v1

# Optional server-side LLM key fallbacks.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Langfuse observability (optional — telemetry is a no-op when unset).
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Free-tier providers (no credit card needed for a key — free signup only).
# Server pools below let keyless users run analyses out of the box.
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# COHERE_API_KEY=
# ZAI_API_KEY=

# OpenCode Console (Go subscription or pay-as-you-go key from
# https://opencode.ai/console). Harness default model is opencode/deepseek-v4.1-flash.
# OPENCODE_API_KEY=
# Plan base URL; defaults to the Go gateway — use https://opencode.ai/inference for PAYG.
# OPENCODE_BASE_URL=https://opencode.ai/inference/go

# Harness CLI — defaults (model, skills, soul, template, budget) live in
# harness.config.json at the api/ root. One-off overrides for the CLI only
# (flags still win; the API ignores these):
# HARNESS_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# HARNESS_SKILLS=dcf-valuation,technical-analysis
# HARNESS_SOURCE=SEC
# HARNESS_TEMPLATE=full-research
